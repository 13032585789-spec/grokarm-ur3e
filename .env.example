# Copy to .env (never commit .env). The key is used only by the backend.
XAI_API_KEY=xai-...
XAI_MODEL=grok-voice-latest
XAI_VOICE=eve
LANG_HINT=it
# sim | ursim | real   (real also requires connections.real.enabled + host in config/robot.yaml)
ROBOT_MODE=ursim
# optional: override the URSim host (default "::1", see config/robot.yaml)
URSIM_HOST=
# optional wake word for noisy rooms, e.g. braccio
WAKE_WORD=
HOST=127.0.0.1
PORT=8000
# --- language / vision / inspection ---
# UI + spoken language at startup (switchable in the page): it en zh es fr de ja
UI_LANG=it
# browser = webcam of the PC running the page; url = poll a snapshot URL (phone IP Webcam: http://<phone-ip>:8080/shot.jpg)
CAMERA_SOURCE=browser
CAMERA_URL=
# grok (needs XAI_API_KEY) | mock (rehearsal, verdict from MOCK_VERDICT)
INSPECTOR=grok
XAI_VISION_MODEL=grok-4.7
MOCK_VERDICT=FAIL
# real robot only, with lab staff present and a hand near the E-stop:
# ALLOW_REAL_MOTION=STAFF_APPROVED
