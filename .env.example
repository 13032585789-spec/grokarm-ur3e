# Copy to .env. The robot server's .env can hold the same keys; this service only reads the ones below.

# push = phone browser page (this service), url = Android "IP Webcam" style snapshot URL
CAMERA_SOURCE=push
# CAMERA_URL=http://192.168.1.23:8080

VISION_PORT=8710
VISION_PHONE_PORT=8711
VISION_PHONE_HTTPS=true
VISION_DATA_DIR=config/vision

# Empty = offline colour/position rules. With a key, Grok picks among detected objects.
XAI_API_KEY=
XAI_VISION_MODEL=grok-4.7
XAI_VISION_TIMEOUT_S=8

# Refuse when the camera moved more than this since calibration.
VISION_MAX_DRIFT_PX=6
VISION_DRIFT_CHECK=true
# Targets must lie this far inside the calibrated area.
VISION_WORKSPACE_MARGIN_MM=10
# Which robot base axis is "left" for the user: +y or -y.
VISION_LEFT_AXIS=+y
