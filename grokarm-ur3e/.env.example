# Copy to .env. Never commit .env.
XAI_API_KEY=

# grok = live voice. offline = typed commands with keyword rules, no key needed.
VOICE_MODE=grok
XAI_VOICE_MODEL=grok-voice-3.0
XAI_VOICE=eve
# none is faster, high thinks more. Measure both.
XAI_REASONING=none

# mock | ursim | real
ROBOT_MODE=mock
ROBOT_HOST=
POSES_FILE=

# Halt on any speech during motion. If motor noise causes false stops, set false.
STOP_ON_ANY_SPEECH=true

# real mode only. Set to STAFF_APPROVED with staff present, then clear it.
ALLOW_REAL_MOTION=

# How long a confirmation waits for a late transcript, in seconds.
CONFIRM_WAIT_S=1.5
